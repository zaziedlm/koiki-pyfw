# Frontend production build environment.
# Copy to .env.production before building a production frontend image.
#
# These values are read at Vite build time. For Docker builds, set
# FRONTEND_BUILD_ENV_FILE to choose which env file is copied to .env.production.
# Runtime container environment variables do not rewrite the already-built SPA.

# Same-origin production is preferred. When API and SPA are hosted on the same
# origin behind a reverse proxy, use a relative base URL:
#   https://app.example.com/         -> frontend
#   https://app.example.com/api/v1/* -> backend
# For local Docker direct access, use frontend/.env.docker or override
# VITE_API_BASE_URL=http://localhost:8000/api/v1.
# VITE_API_PREFIX is only used as a fallback when VITE_API_BASE_URL is omitted.
# VITE_API_PREFIX=/api/v1
VITE_API_BASE_URL=/api/v1

VITE_SSO_REDIRECT_URI=/sso/callback
VITE_SAML_REDIRECT_URI=/auth/saml/callback

VITE_APP_NAME=KOIKI Framework Frontend
VITE_APP_VERSION=0.1.0
