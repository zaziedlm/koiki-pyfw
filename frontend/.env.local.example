# Frontend local development environment.
# Copy this file to .env.local and customize for your machine.
#
# Vite exposes only VITE_* variables to browser code.
# Cookie names, SameSite, Secure, allowed origins, and CORS policy are backend settings.

# Browser-facing backend API.
VITE_API_URL=http://localhost:8000
VITE_API_PREFIX=/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Browser callback paths.
VITE_SSO_REDIRECT_URI=/sso/callback
VITE_SAML_REDIRECT_URI=/auth/saml/callback

# Public display metadata.
VITE_APP_NAME=KOIKI Framework Frontend
VITE_APP_VERSION=0.1.0
