# Frontend Docker build environment.
#
# Vite embeds these values during `npm run build`.
# For local Docker Compose, browser traffic reaches the backend through the
# host-published port, so use localhost rather than the internal compose name.

VITE_API_URL=http://localhost:8000
VITE_API_PREFIX=/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

VITE_SSO_REDIRECT_URI=/sso/callback
VITE_SAML_REDIRECT_URI=/auth/saml/callback

VITE_APP_NAME='KOIKI Framework Frontend(2026)'
VITE_APP_VERSION=0.1.0
