# syntax=docker/dockerfile:1.7
# Unified Dockerfile for backend (dev/optimized/production)

ARG PYTHON_VERSION=3.13.18-slim-bookworm

# ---------------------
# Base: common tools, certs, uv
# ---------------------
FROM python:${PYTHON_VERSION} AS base

ARG DEBIAN_FRONTEND=noninteractive

# CA certificates and curl with BuildKit cache
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Add custom certificate
# Optional organization CA; session proxy roots are supplied separately as BuildKit secrets.
RUN --mount=type=bind,source=docker/certs,target=/run/koiki-ca,readonly \
    if [ -f /run/koiki-ca/nscacert.pem ]; then \
      install -m 0644 /run/koiki-ca/nscacert.pem /usr/local/share/ca-certificates/nscacert.crt; \
    fi
RUN update-ca-certificates

# Common environment
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=off \
    PIP_DISABLE_PIP_VERSION_CHECK=on

COPY --from=ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff /uv /uvx /usr/local/bin/

ENV UV_CACHE_DIR=/opt/uv-cache \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

RUN uv --version

WORKDIR /app

# ---------------------
# Builder: install dependencies (all or main-only)
# ---------------------
FROM base AS builder

ARG INSTALL_MAIN_ONLY=false

COPY pyproject.toml uv.lock README.md ./
COPY ./app ./app
COPY ./apps ./apps
COPY ./components ./components
COPY ./ops ./ops

RUN --mount=type=cache,target=$UV_CACHE_DIR \
    --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export SSL_CERT_FILE=/run/secrets/proxy_ca; fi; \
    if [ "${INSTALL_MAIN_ONLY}" = "true" ]; then \
      uv sync --locked --no-dev --no-editable; \
    else \
      uv sync --locked --group dev --group test --no-editable; \
    fi

# Entry point script
COPY docker-entrypoint.sh ./
RUN chmod +x /app/docker-entrypoint.sh

# ---------------------
# Dev stage (hot reload, mounts expected)
# ---------------------
FROM builder AS dev
RUN adduser --disabled-password --gecos "" appuser && \
    mkdir -p /app/components/koiki_ref_app/alembic/versions && \
    chown -R appuser:appuser /app
USER appuser
ENTRYPOINT ["/app/docker-entrypoint.sh"]
EXPOSE 8000
CMD ["uvicorn", "koiki_ref_app.asgi:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

# ---------------------
# Optimized stage (BuildKit-friendly, no reload)
# ---------------------
FROM builder AS optimized
RUN adduser --disabled-password --gecos "" appuser && \
    mkdir -p /app/components/koiki_ref_app/alembic/versions && \
    chown -R appuser:appuser /app
USER appuser
ENTRYPOINT ["/app/docker-entrypoint.sh"]
EXPOSE 8000
CMD ["uvicorn", "koiki_ref_app.asgi:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]

# Install only application dependencies into the final image.
FROM builder AS production-deps
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export SSL_CERT_FILE=/run/secrets/proxy_ca; fi; \
    uv sync --locked --no-dev --no-editable

# ---------------------
# Production runtime stage (main deps only)
# ---------------------
FROM python:${PYTHON_VERSION} AS production

ARG DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Optional organization CA; session proxy roots are supplied separately as BuildKit secrets.
RUN --mount=type=bind,source=docker/certs,target=/run/koiki-ca,readonly \
    if [ -f /run/koiki-ca/nscacert.pem ]; then \
      install -m 0644 /run/koiki-ca/nscacert.pem /usr/local/share/ca-certificates/nscacert.crt; \
    fi
RUN update-ca-certificates

ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Drop unused system installer and its bundled wheel from the runtime.
RUN /usr/local/bin/python -m pip uninstall -y pip && \
    rm -rf /usr/local/lib/python3.13/ensurepip

WORKDIR /app
RUN adduser --disabled-password --gecos "" appuser

# Copy runtime artifacts
COPY --from=production-deps /app /app

RUN mkdir -p /app/components/koiki_ref_app/alembic/versions && chown -R appuser:appuser /app
USER appuser

ENTRYPOINT ["/app/docker-entrypoint.sh"]
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/ || exit 1
EXPOSE 8000
CMD ["uvicorn", "koiki_ref_app.asgi:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
